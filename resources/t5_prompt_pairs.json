{
  "about": "Tested A/B impulse pairs for the T5 Oscillator dice. Every pair was rendered in the built standalone on Stable Audio 3 Medium (tonal slot), linear injection, at nine A/B positions from -1 to +1 and on two seeds, and passed: complete render, every note sounding, no clipping, no collapse, and the slider changing the sound. Pitch and tempo are part of the prompt text: ', c3' puts the generated pitch on C, ', 140bpm' sets a tempo, and prompts that name no pitch leave it to the model. Tags describe each prompt on three axes: time = how the sound unfolds, material = what is vibrating, source = what makes it. A missing tag means no value on that axis fits. The contrast describes the pair: how A and B stand to each other.",
  "axes": [
    { "key": "time", "label": "Time",
      "values": [ { "key": "struck",    "label": "struck / plucked" },
                  { "key": "sustained", "label": "sustained" },
                  { "key": "texture",   "label": "event texture" },
                  { "key": "noise",     "label": "steady noise" },
                  { "key": "groove",    "label": "groove" } ] },
    { "key": "material", "label": "Material",
      "values": [ { "key": "metal",    "label": "metal" },
                  { "key": "wood",     "label": "wood" },
                  { "key": "glass",    "label": "glass" },
                  { "key": "string",   "label": "string" },
                  { "key": "air",      "label": "air column" },
                  { "key": "voice",    "label": "voice" },
                  { "key": "electric", "label": "electric" } ] },
    { "key": "source", "label": "Source",
      "values": [ { "key": "instrument", "label": "instrument" },
                  { "key": "voice",      "label": "voice" },
                  { "key": "nature",     "label": "nature" },
                  { "key": "machine",    "label": "machine" },
