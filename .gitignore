/build/
/build_clean/
/build_ci_local_app/
.cache/
*.o
*.so
*.dylib
*.exe

# ...except the vendored Csound payload, which IS source here: the whole point of
# third_party/csound is that a build machine needs no Csound of its own. The
# patterns above silently swallowed the macOS payload's 9 support libraries and
# 24 plugin opcode modules once already (558ea7ce committed CsoundLib64 alone),
# and CI only noticed at the bundling step, long after linking succeeded.
!/third_party/csound/**
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json

# IDE
.vscode/
.idea/
.claude/scheduled_tasks.lock
*.swp
*~

# Python backend venv
.venv/
.venv-coder/
venv/
.codex
backend/venv/
backend/__pycache__/
backend/build/
backend/dist/
backend/dist.stale-*/
backend/hf_assets/
*.pyc

# Local assembled distributions / archives
dist/
archives/

# Models (user downloads separately)
models/

# Secrets
*.key

# OS
.DS_Store
Thumbs.db
exported_models/

# Ad-hoc compiled diagnostics
tools/test_delay_damp
tools/test_inference
tools/test_reprompt_stances
tools/measure_engine_levels
tools/measure_poly_independence
tools/audition_lro_level_match

# Listening-test render output
tools/init_audio_test_output/
tools/resynth_loop_out/
# CLAP homeostasis: keep REPORT.md + results_*.json, drop the WAV renders
tools/clap_homeostasis_out/*.wav
tools/clap_homeostasis_out/results.json
# lco_reference: keep the PROMPT.txt beside each set and comparison.json, drop the
# reference audio itself -- 18 MB for eight instruments, and `lco_reference.py
# generate` recreates it from the recorded prompt and seed. A real recording
# dropped in by hand is NOT covered by this and has to be added deliberately,
# with its licence.
tools/lco_reference_out/*/sa3_*.wav
tools/lco_reference_out/*/*_sa3_*.wav
tools/lco_reference_out/*/lco_*.wav
tools/lco_reference_out/*/incumbent_*.wav
# CLAP semantic loop: keep REPORT.md + per-experiment manifest.json, drop WAVs + run log
tools/clap_semantic_loop_out/*/*.wav
tools/clap_semantic_loop_out_run.log
tools/clap_semantic_loop_scout.log
# CLAP+LLM loop: keep REPORT.md + per-mode manifest.json, drop WAVs + run log
# (** so alpha-tagged sub-runs like clap_llm_loop_out/aB10/<mode>/*.wav are covered too)
tools/clap_llm_loop_out/**/*.wav
tools/clap_llm_loop_out_run.log
# prompt-bite diagnostic: keep the script, drop its WAVs
tools/diag_promptbite_out/
# scratch dirs written by verification agents
tools/_bugcheck_out*/

# Stray non-standard build dir
/build_updtest/

# Accumulated render output (keep the scripts, drop the WAV/PNG renders)
tools/alpha0_collapse_out/
tools/csound_engine_out/
tools/delay_audition_out/
tools/env_loop_audition_out/
tools/lco_ab_analog_drive/
tools/loop_hang_out/
tools/medium_probe_out/
tools/medium_sweep_out/
tools/resynth_band_fix_out/
tools/resynth_platform_out/
tools/tracktype_audition_out/
tools/filter_os_test/out/
# compiled diagnostic binaries
tools/filter_os_test/filter_bench
tools/filter_os_test/filter_os_test

# Compiled tools/*.cpp probes (extensionless Mach-O; the sources are tracked)
/tools/audition_lro_oversampling
/tools/audition_lro_drive
/tools/audition_amp_effects
/tools/csound_orch_check
/tools/measure_note_latency
/tools/audition_snapshot_switch

# Instrument A/B folders (one per entry: nearest_existing vs new, both pitches).
# Keep the .orc bodies and any hand-written note -- those ARE the record of what
# was compared; drop the renders and the level bookkeeping, which the matching
# tools/lco_ab_*.py regenerates. Deliberately NOT a directory rule: two .orc
# bodies under tools/lco_ab_string_bowed/ are tracked, and `tools/lco_ab_*/`
# would silently shadow them.
tools/lco_ab_*/*.wav
tools/lco_ab_*/*.npz
tools/lco_ab_*/levels.json
tools/ab_snapshot_click/*.wav
tools/lco_morph_time_ab/*.wav

# Audition/diagnostic output dirs (no tracked file inside any of them; each holds
# renders plus the compiled probe that wrote them)
tools/csound_swap_out/
tools/csound_preset_roundtrip_out/
tools/env_bend_out/
tools/lco_trace_wire_out/

# Hidden scratch measurement scripts (the shipped ones carry no leading dot)
tools/.lco_*.py

# Local recovery snapshots, agent memory and test logs; not part of the project
/.codex_safety/
/.claude/projects/
/recovery/backend_test*.log
